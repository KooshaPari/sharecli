# .dockerignore — exclude sensitive files from Docker build context
# Addresses SonarCloud CRITICAL: "Copying recursively might inadvertently add sensitive data"
.git
**/.git
**/target
**/target-*
**/.target
**/node_modules
**/.venv
**/dist
**/.archive

# Exclude CI/CD, governance, and docs (not needed for build)
.github
scripts/
tests/
docs/
audit/
contrib/
desktop/
lib/
preserved/
*.md
!README.md

# Exclude config, secrets, and build artifacts (but keep Cargo.toml/Cargo.lock)
*.json
*.yaml
*.yml
*.sh
*.py
*.js
*.mjs
*.ts
*.tsx
*.html
*.css
*.png
*.svg
*.ico
*.plist
*.pem
*.key
*.crt
*.p12
*.env
*.env.*
Dockerfile
.dockerignore
LICENSE
*.dmg
*.zip
*.tar.gz
docs/sessions
recovery
