<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ShareCLITray.TrayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="sharecli Dashboard">
    <Grid Padding="12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: Health Status -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock
                Text="sharecli Process Manager"
                Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock x:Name="HealthStatusText" Text="Checking health..." />
            <TextBlock
                x:Name="ThermalBadgeText"
                Text=""
                FontWeight="SemiBold"
                FontFamily="Consolas" />
            <TextBlock
                x:Name="GateStatusText"
                Text=""
                FontFamily="Consolas"
                IsTextSelectionEnabled="True" />
            <TextBlock
                x:Name="HostWatchStatusText"
                Text=""
                FontFamily="Consolas"
                IsTextSelectionEnabled="True" />
            <TextBlock
                x:Name="PoolStatusText"
                Text=""
                FontFamily="Consolas"
                IsTextSelectionEnabled="True" />
            <TextBlock
                x:Name="StatusSnapshotText"
                Text=""
                FontFamily="Consolas"
                IsTextSelectionEnabled="True" />
        </StackPanel>

        <!-- Process List -->
        <ListView
            Grid.Row="1"
            x:Name="ProcessGrid"
            SelectionMode="None">
            <ListView.Header>
                <Grid Padding="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="PID" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Memory (MB)" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Project" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="Harness" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="Actions" FontWeight="SemiBold" />
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding pid}" />
                        <TextBlock Grid.Column="1" Text="{Binding name}" />
                        <TextBlock Grid.Column="2" Text="{Binding memory_mb}" />
                        <TextBlock Grid.Column="3" Text="{Binding project}" />
                        <TextBlock Grid.Column="4" Text="{Binding harness}" />
                        <Button
                            Grid.Column="5"
                            Content="Kill"
                            Click="OnKillProcessClick"
                            Tag="{Binding pid}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Buttons -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="8"
            HorizontalAlignment="Right">
            <Button Content="Refresh" Click="OnRefreshClick" />
            <Button
                Content="Kill All Managed"
                Click="OnKillAllClick"
                Foreground="Red" />
            <Button Content="Close" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
