<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- WindowsAppSDK 1.6.250602001 is a valid 1.6.x patch bump. The historical
         XamlCompiler.exe (net472, MSB3073) crash was caused by XAML markup that is
         invalid for WinUI 3 `Window`: a `Background` attribute and `Width`/`Height`
         attributes (WinUI 3 `Window` exposes none of those properties), which crashed
         the net472 XamlCompiler pre-pass with exit code 1 and no diagnostic. The tray
         process list was also migrated off the UWP-era WinUI 2
         CommunityToolkit.WinUI.UI.Controls.DataGrid to a native WinUI 3 `ListView`,
         so that package is no longer referenced. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250602001" />
  </ItemGroup>
</Project>
