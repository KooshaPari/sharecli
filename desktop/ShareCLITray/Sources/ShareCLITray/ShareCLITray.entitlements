<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Minimal entitlements for Swift / native macOS menubar apps.
  Configure in Signing & Capabilities tab of Xcode or in the .entitlements file
  referenced from Info.plist.
-->
<plist version="1.0">
<dict>
  <!-- App sandbox is required for Mac App Store, optional for direct distribution.
       Direct-distribution builds can omit this. -->
  <!-- <key>com.apple.security.app-sandbox</key>
  <true/> -->

  <key>com.apple.security.network.client</key>
  <true/>

  
  <!-- Sparkle auto-update requires hardened runtime + network client.
       If you ship a notarized DMG, Sparkle will download + verify + launch. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- sharecli tray talks to the IPC sidecar via Unix socket -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
