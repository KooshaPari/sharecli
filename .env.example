# Example environment configuration for sharecli.
# Copy this file to `.env` and uncomment the variables you need.

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
# DEBUG=false
# LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Serve auth (runtime secrets — never commit real values)
# ------------------------------------------------------------------------------
# SHARECLI_SERVE_TOKEN=replace-me
# SHARECLI_SERVE_AUTH_MODE=jwt
# SHARECLI_SERVE_JWT_ISSUER=https://login.example.com/
# SHARECLI_SERVE_JWT_AUDIENCE=api://sharecli-serve
# SHARECLI_SERVE_JWKS_PATH=/etc/sharecli/jwks.json
