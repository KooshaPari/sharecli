  "extends": [
    "config:base",
    ":semanticCommits"
  ],
  "schedule": [
    "every weekend"
  ],
  "automerge": false,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    }
  ]
}
